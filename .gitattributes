# 统一换行符；Windows 脚本用 CRLF
* text=auto

*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.cs        text eol=crlf
*.xml       text eol=crlf
*.manifest  text eol=crlf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf

*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.zip   binary
*.exe   binary
